class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n= nums.size();
      
        for (int i =0;i<n;i++){
              int numm=0;
            for(int j=0;j<n;j++){
                 if (nums[j] == nums[i]) {
                numm++;
            }
        }
        if(numm>(n/2)){
            return nums[i];
        }
      }
         return -1;
        
    }
};



better approach   using hashmap
class Solution {
public:
    int majorityElement(vector<int>& nums) {
        map<int,int>mappp;
        int n=nums.size();
        for (int i=0;i<n;i++){
            mappp[nums[i]]++; //Each element in the vector v is treated as a key in the map.
        }                     //The value associated with each key is the count of occurrences of that key in the vector.
                                 //mpp = {3: 3, 4: 4, 2: 1} for another example 
        for (auto it: mappp){
            if (it.second>(n/2)){
                return it.first;
            }
        }
        return -1;
    }
};




